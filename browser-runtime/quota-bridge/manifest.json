{
  "manifest_version": 3,
  "name": "Claude-Local Quota Bridge",
  "version": "1.0.0",
  "description": "User-triggered, read-only subscription metadata sync for the isolated Claude-Local Browser.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*/browser.html"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/settings/usage*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
